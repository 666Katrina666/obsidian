"smart_blocks:Fanfics/313.1. Shadow Siege - Teni Gotema and Story.md##Глава 5: Тени и забота **Действующие лица**: Астер, Дамиан, Брюс, Касс (второстепенные: Дик). **События**: Астер сражается с сущностью, сталкиваясь с Дамианом, который ворчит, но уважает его навыки. Брюс хвалит Астера. **Ключевой момент**: Касс говорит: \"Ты важен для нас\", и Астер краснеет.": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06025422,-0.00864984,0.03944663,-0.00443094,-0.0093378,0.04016284,-0.02982024,0.05862125,0.08038228,-0.06935576,-0.00625791,-0.02338395,0.02618002,-0.0448417,0.03846027,-0.02078547,0.00971208,0.03370055,-0.09885929,-0.00535216,0.0674329,-0.09652753,0.0484126,-0.04390706,-0.01093461,-0.00294108,-0.01263514,-0.03101783,-0.0680424,-0.1945961,0.03217353,-0.04352841,0.06526733,0.00624596,0.01025548,-0.05428723,-0.0628483,0.04082388,-0.05583117,0.06105957,0.01435061,-0.03604287,-0.00426018,-0.04565386,-0.01177934,-0.04002422,-0.03903269,0.00442442,0.01154428,0.00258885,-0.06793295,-0.02194689,-0.02100386,0.02277369,0.00526318,-0.06933045,0.05557327,0.03421218,0.10803914,0.02124832,0.05973026,0.01855576,-0.23494366,0.00533602,0.02015951,-0.01281395,0.01499963,0.03671476,0.0001033,0.04468209,-0.05661697,0.07763864,-0.05447131,0.04505286,-0.00406852,0.00673579,-0.02390172,-0.03725278,-0.03032506,-0.03923798,-0.04818786,0.01938316,-0.04592673,-0.02348087,0.01053412,-0.0162272,0.04439803,-0.02526371,-0.01537353,0.04095064,-0.026808,0.01433294,0.05643431,0.04593169,-0.03008308,-0.04943511,-0.01118274,-0.00499901,-0.00804112,0.09632578,-0.00837606,-0.05307108,0.018412,-0.01388982,0.07398593,-0.0458082,-0.02461757,-0.06135464,-0.01759581,-0.00167472,-0.03226146,0.00022258,0.09546734,-0.0311674,0.09389164,0.00613958,0.01163151,0.01071774,-0.0200526,0.01796748,0.02328875,-0.03987937,0.05540447,0.0189618,0.01870432,-0.01971597,0.04445319,0.04086956,0.05316665,0.05769258,0.03935962,0.01512113,-0.08548844,-0.06466381,-0.00478764,0.01860572,-0.03021953,0.02645804,-0