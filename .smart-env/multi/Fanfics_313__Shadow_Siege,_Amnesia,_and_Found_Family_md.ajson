"smart_blocks:Fanfics/313. Shadow Siege, Amnesia, and Found Family.md##Глава 5: Тени и забота#Глава 6: Финальная битва **Действующие лица**: Астер, Брюс, Дик, Касс (второстепенные: Барбара). **События**: Сущности под руководством космического существа атакуют Готэм. Астер сражается, используя лунные лучи и барьеры. Брюс и Дик поддерживают его. Астер побеждает главную сущность, теряя сознание.": {"path":null,"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04459717,-0.03615533,0.03325549,-0.00046989,0.02298006,0.0230641,-0.02606995,0.03748956,0.074154,-0.0806936,0.01579946,-0.03647709,0.02653554,-0.01936503,0.00713551,-0.01654038,-0.0263199,0.05262119,-0.08095159,-0.0247609,0.04572866,-0.10037501,0.04371108,-0.05573442,-0.00192931,0.01472008,-0.01207732,-0.02075339,-0.06453957,-0.21036945,0.01273348,-0.02835959,0.07582726,-0.01040434,0.00368626,-0.04322837,-0.06251147,0.04390511,-0.04403403,0.04804067,-0.01260132,-0.04007055,0.00457868,-0.03482031,-0.00037014,-0.01269771,-0.00468986,-0.00479519,0.03597651,-0.02224285,-0.08144943,-0.00444082,-0.01029651,0.01977564,-0.01326213,-0.02812564,0.06616861,0.01596998,0.06795523,0.03826081,0.08058304,0.00071722,-0.22232588,0.00039657,0.01633003,0.02613819,-0.01531372,-0.00166836,0.01540795,0.02204005,-0.07413417,0.06063628,-0.05995619,0.04697575,0.00614823,0.03608721,-0.01175092,-0.0381119,-0.04119577,-0.0756868,-0.00817603,0.0370967,-0.02777705,-0.02582027,0.02325991,-0.01106841,0.06027509,-0.04865592,-0.025434,0.06977957,-0.03917564,0.03982636,0.06934409,0.03754538,-0.05020631,-0.02244717,0.00972908,0.01320527,-0.06194588,0.08087373,-0.00242038,-0.0333437,-0.00299585,0.00133229,0.05639397,-0.0642615,-0.0083545,-0.04427359,-0.01687224,-0.02304539,-0.02755976,-0.02222356,0.12798814,-0.03185347,0.08798384,0.00635494,0.0133681,0.04590418,-0.03157352,0.02095679,0.02817225,-0.05339287,0.08446322,0.01479232,0.06872625,0.00013445,-0.00287862,0.05998093,0.05123685,0.0590459,0.02745762,0.03087694,-0.02589563,-0.0514709,-0.00519112,0.0